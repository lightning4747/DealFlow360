# DealFlow360 Environment Variables

# Node environment
NODE_ENV=development

# Core API & Gateway Ports
PORT=3000
KONG_HTTP_PORT=8000
KONG_ADMIN_PORT=8001

# PostgreSQL Database (PostGIS + TimescaleDB enabled)
DATABASE_URL=postgresql://dealflow:dealflow_secret@localhost:5433/dealflow360
POSTGRES_USER=dealflow
POSTGRES_PASSWORD=dealflow_secret
POSTGRES_DB=dealflow360
POSTGRES_PORT=5433

# Redis Cache & BullMQ Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Apache Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=dealflow360-app

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_dealflow360_change_in_production
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d
PORTAL_MAGIC_LINK_SECRET=super_secret_magic_link_key_dealflow360

# Payments (Razorpay test mode; never commit real credentials)
PAYMENT_GATEWAY_MODE=razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# SMTP (use a Gmail app password or Mailpit locally)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=replace_with_app_password
MAIL_FROM=DealFlow360 <your-email@example.com>

# Frontend Apps
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
