{
  "name": "dealflow360",
  "private": true,
  "version": "1.0.0",
  "description": "Intelligent, Self-Governing Sales Operations Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @dealflow360/database db:generate",
    "db:migrate": "pnpm --filter @dealflow360/database db:migrate",
    "db:seed": "pnpm --filter @dealflow360/database db:seed"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
