      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*)::int FROM deal_studio.quotes WHERE status NOT IN ('CONVERTED', 'CLOSED_LOST', 'EXPIRED');",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "title": "Hourly Quote Velocity (Last 24h)",
      "type": "timeseries",
      "datasource": "dealflow360-postgres",
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', created_at) as time, COUNT(*) as value, event_type as metric FROM analytics.quote_events WHERE created_at >= NOW() - INTERVAL '24 hours' GROUP BY 1, 3 ORDER BY 1 ASC;",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "title": "Discount Variance by Rep (z-score distribution)",
      "type": "barplot",
      "datasource": "dealflow360-postgres",
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT rep_id, AVG(applied_discount_pct)::float as avg_discount, MAX(applied_discount_pct)::float as max_discount FROM analytics.rep_discount_tracking WHERE time >= NOW() - INTERVAL '30 days' GROUP BY rep_id LIMIT 10;",
          "refId": "A"
        }
      ]
    }
