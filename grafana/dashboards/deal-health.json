    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "title": "Stalled Deals (> 7 Days Inactive)",
      "type": "stat",
      "datasource": "dealflow360-postgres",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*)::int as count FROM deal_studio.quotes WHERE status NOT IN ('CONVERTED', 'CLOSED_LOST', 'EXPIRED') AND COALESCE(updated_at, created_at) < NOW() - INTERVAL '7 days';",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "title": "Discount Anomalies (z > 2.0)",
      "type": "stat",
      "datasource": "dealflow360-postgres",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT COUNT(*)::int FROM analytics.rep_discount_tracking WHERE applied_discount_pct > tier_ceiling_pct AND time >= NOW() - INTERVAL '7 days';",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
